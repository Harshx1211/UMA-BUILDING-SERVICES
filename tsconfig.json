{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "strictFunctionTypes": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noImplicitReturns": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "moduleResolution": "bundler",
    "paths": {
      "@/*": [
        "./*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx"
  ],
  "exclude": [
    "node_modules",
    "admin",
    "website",
    "superadmin",
    // Supabase Edge Functions use Deno's runtime with HTTP imports (esm.sh, deno.land).
    // Excluding this directory prevents VS Code's TypeScript server from trying to
    // resolve Deno HTTP imports using Node/bundler moduleResolution, which always fails.
    "supabase/functions"
  ]
}
