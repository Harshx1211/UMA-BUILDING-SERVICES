# Supabase — same project as the mobile app / admin portal
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
# No separate JWT secret needed — incoming Bearer tokens are verified via
# db.auth.getUser(token) (see src/auth.ts), which asks Supabase's own Auth
# server to validate the token. That's what makes this work regardless of
# whether a given token was signed with this project's legacy shared HS256
# secret or its current asymmetric signing key (Settings -> API -> JWT Keys).

# Gotenberg — reachable only on the private network between containers in production.
GOTENBERG_URL=http://gotenberg:3000

# Storage buckets (both private).
REPORT_BUCKET=job-reports
PHOTO_BUCKET=job-photos

# Tunables — see plan doc "Reliability & operations" section for rationale.
MAX_ASSETS_PER_CHUNK=200
GOTENBERG_CONCURRENCY=2
GOTENBERG_TIMEOUT_MS=60000
CHUNK_RETRY_ATTEMPTS=2
PHOTO_SIGNED_URL_TTL_SECONDS=1800

PORT=8080
