# Supabase — same project as the mobile app / admin portal
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
# Required to verify caller JWTs ourselves (Settings -> API -> JWT Secret in Supabase dashboard).
# Unlike a Supabase Edge Function, this service is NOT behind Supabase's own gateway,
# so an incoming Bearer token is never pre-validated for us — we must verify the
# signature here or any string claiming to be a JWT would be trusted.
SUPABASE_JWT_SECRET=your_jwt_secret_here

# Gotenberg — reachable only on the private network between containers in production.
GOTENBERG_URL=http://gotenberg:3000

# Storage buckets (both private).
REPORT_BUCKET=job-reports
PHOTO_BUCKET=job-photos

# Tunables — see plan doc "Reliability & operations" section for rationale.
MAX_ASSETS_PER_CHUNK=200
GOTENBERG_CONCURRENCY=2
GOTENBERG_TIMEOUT_MS=60000
CHUNK_RETRY_ATTEMPTS=2
PHOTO_SIGNED_URL_TTL_SECONDS=1800

PORT=8080
