# Supabase — same project as the mobile app / admin portal
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
# Incoming Bearer tokens are verified via db.auth.getUser(token) (src/auth.ts),
# so no separate JWT secret is needed.

# Chromium binary. The Docker image sets this to /usr/bin/chromium itself.
# For local runs on Windows, point it at installed Chrome, e.g.:
# CHROMIUM_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
CHROMIUM_PATH=/usr/bin/chromium

# Storage buckets (both private).
REPORT_BUCKET=job-reports
PHOTO_BUCKET=job-photos

# Tunables
MAX_ASSETS_PER_CHUNK=200
# Per render pass (two passes per report).
RENDER_TIMEOUT_MS=300000
# Reports rendered at once per instance (each launches its own Chromium).
# Extra requests wait for a slot instead of risking an out-of-memory kill.
MAX_CONCURRENT_RENDERS=2
CHUNK_RETRY_ATTEMPTS=2
# SIGTERM grace for in-flight reports. Cloud Run force-kills 10s after SIGTERM.
SHUTDOWN_GRACE_MS=8000

# Cloud Run only: a long random string. Enables the self-invocation pattern
# (POST /internal/run) that keeps CPU allocated for the whole render.
# Leave empty locally — generation then runs in-process.
INTERNAL_RUN_SECRET=

PORT=8080
